# Canonical public URL of the site, without a trailing slash.
# Used for metadata, sitemap.xml, and robots.txt. If unset on Netlify,
# the build falls back to Netlify's built-in URL variable.
NEXT_PUBLIC_SITE_URL=

# Booking availability (server-side only; read by netlify/functions/availability.ts).
# Never prefix these with NEXT_PUBLIC_. Set real values in Netlify, not in this file.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
BOOKING_TIMEZONE=
# Development only: set to "mock" for sample availability. Ignored in production deploys.
BOOKING_AVAILABILITY_MODE=
